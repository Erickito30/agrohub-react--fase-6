classDiagram
direction LR
class Produtor {
  <<boundary>>
  +String produto
  +String quantidade
  +String validade
  +String retirada
  +handleSubmit(event) void
}
class NotificationsProvider {
  <<control>>
  -Excedente[] excedentes
  -Notificacao[] notifications
  +Number unreadCount
  +addExcedente(dados) void
  +markAllAsRead() void
}
class Ong {
  <<boundary>>
  -String activeFilter
  -Number maxDistance
  -Set~Number~ scheduledIds
  -Excedente[] favorites
  -Boolean showingFavorites
  +handleSchedule(id) void
  +toggleFavorite(item) void
}
class Excedente {
  <<data>>
  +Number id
  +String category
  +Number distance
  +String title
  +String meta
  +String badge
  +String priority
  +Boolean scheduled
  +String icon
}
class Notificacao {
  <<data>>
  +Number id
  +String mensagem
  +String hora
  +Boolean lida
}
Produtor ..> NotificationsProvider : addExcedente
NotificationsProvider "1" *-- "0..*" Excedente : estado da sessao
NotificationsProvider "1" *-- "0..*" Notificacao : estado da sessao
Ong ..> NotificationsProvider : useNotifications
Ong "1" --> "0..*" Excedente : favorites - snapshots locais
Excedente "1" -- "0..1" Notificacao : cadastro origina
