---
config:
  theme: base
  themeVariables:
    primaryColor: "#eef4ec"
    primaryBorderColor: "#2f5d3a"
    primaryTextColor: "#1d2b20"
    lineColor: "#2f5d3a"
    fontFamily: "Helvetica, Arial, sans-serif"
---
classDiagram
direction TB
class Usuario {
  #Number id
  #String nome
  #String email
  #String cidade
  +cadastrar() void
  +atualizarDados(dados) void
}
class Produtor {
  -String localRetirada
  +cadastrarExcedente(produto, quantidade, validade) Excedente
  +listarExcedentes() Excedente[]
}
class ONG {
  -String cnpj
  -Excedente[] favoritos
  +filtrarExcedentes(categoria, distanciaMax) Excedente[]
  +agendarColeta(excedente) Agendamento
  +favoritar(excedente) void
  +removerFavorito(excedente) void
  +listarFavoritos() Excedente[]
}
class Excedente {
  -Number id
  -String produto
  -String quantidade
  -Date validade
  -String categoria
  -Number distancia
  -String status
  +estaDisponivel() Boolean
  +marcarComoAgendado() void
}
class Agendamento {
  -Number id
  -Date dataColeta
  -String status
  +confirmar() void
  +cancelar() void
}
class CentralNotificacoes {
  -Notificacao[] notificacoes
  +notificar(excedente) Notificacao
  +marcarTodasComoLidas() void
  +contarNaoLidas() Number
}
class Notificacao {
  -Number id
  -String mensagem
  -String hora
  -Boolean lida
  +marcarComoLida() void
}
Usuario <|-- Produtor : herança
Usuario <|-- ONG : herança
Produtor "1" *-- "0..*" Excedente : cadastra
CentralNotificacoes "1" *-- "0..*" Notificacao : armazena
Excedente "1" --> "1" Notificacao : gera
ONG "0..*" --> "0..*" Excedente : favorita
ONG "1" --> "0..*" Agendamento : agenda
Agendamento "0..1" --> "1" Excedente : refere-se a
